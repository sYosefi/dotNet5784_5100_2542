<Window x:Class="PL.Task.Task"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Task"
        mc:Ignorable="d"
        Title="Task" Height="532" Width="890"
        DataContext="{Binding TaskItem,RelativeSource={RelativeSource Self},Mode=TwoWay}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1.5*"/>
        </Grid.RowDefinitions>
        <Label Grid.Column="0" Grid.Row="1" HorizontalAlignment="Right"  VerticalAlignment="Center" FontSize="15"  Content="Task Number:" ></Label>
        <TextBox Grid.Column="1" Grid.Row="1"  Height="25" Width="300" HorizontalAlignment="Left" TextAlignment="Center" BorderBrush="Green" BorderThickness="2" FontSize="13"  IsEnabled="{Binding Id, Mode=OneTime, Converter={StaticResource ConvertIdToBoolKey}}"
                   Text="{Binding TaskNumber, Mode=TwoWay, NotifyOnValidationError=true,
                   ValidatesOnExceptions=true}"></TextBox>
        <Label Grid.Column="0" Grid.Row="2" HorizontalAlignment="Right"  VerticalAlignment="Center" FontSize="15"  Content="Descreption:"></Label>
        <TextBox Grid.Column="1" Grid.Row="2" Height="25" Width="300" HorizontalAlignment="Left" TextAlignment="Center" BorderBrush="Green" BorderThickness="2" FontSize="13" 
                 Text="{Binding Description, Mode=TwoWay, NotifyOnValidationError=true,
                 ValidatesOnExceptions=true}"></TextBox>
        <Label Grid.Column="0" Grid.Row="3" HorizontalAlignment="Right"  VerticalAlignment="Center" FontSize="15"  Content="Nickname:"></Label>
        <TextBox Grid.Column="1" Grid.Row="3" Height="25" Width="300" HorizontalAlignment="Left" TextAlignment="Center" BorderBrush="Green" BorderThickness="2" FontSize="13" 
                 Text="{Binding Nickname, Mode=TwoWay, NotifyOnValidationError=true,
                 ValidatesOnExceptions=true}"></TextBox>
        <Label Grid.Column="0" Grid.Row="4" HorizontalAlignment="Right"  VerticalAlignment="Center" FontSize="15"  Content="Status:"></Label>
        <ComboBox Grid.Column="1" Grid.Row="4" Height="25" Width="300" HorizontalAlignment="Left"  Background="White" BorderBrush="Green" BorderThickness="2" FontSize="13"
                  ItemsSource="{Binding Source={StaticResource StatusCollectionKey}}"
                  SelectedValue="{Binding Status, Mode=TwoWay, NotifyOnValidationError=true,
                  ValidatesOnExceptions=true}"></ComboBox>
        <Label Grid.Column="0" Grid.Row="5" HorizontalAlignment="Right"  VerticalAlignment="Center" FontSize="15"  Content="Dependencies List:"></Label>
        <!--<TextBox Grid.Column="1" Grid.Row="5" Height="25" Width="300" HorizontalAlignment="Left" TextAlignment="Center" BorderBrush="Green" BorderThickness="2" FontSize="13"
                   Text="{Binding DependenciesList, Mode=TwoWay, NotifyOnValidationError=true,
                   ValidatesOnExceptions=true}"/>-->
        <TextBox Grid.Column="1" Grid.Row="5" Height="25" Width="300" HorizontalAlignment="Left" 
         Text="{Binding DependenciesInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         BorderBrush="Green" BorderThickness="2" FontSize="13"/>
        <Label Grid.Column="0" Grid.Row="6" HorizontalAlignment="Right"  VerticalAlignment="Center" FontSize="15"  Content="Production Date:"></Label>
        <DatePicker Grid.Column="1" Grid.Row="6" Height="25" Width="300" HorizontalAlignment="Left"  BorderBrush="Green" BorderThickness="2" FontSize="13" 
                 Text="{Binding ProductionDate, Mode=TwoWay, NotifyOnValidationError=true,
                   ValidatesOnExceptions=true}"/>
        <Label Grid.Column="0" Grid.Row="7" HorizontalAlignment="Right"  VerticalAlignment="Center" FontSize="15"  Content="Estimated Start Date:"></Label>
        <DatePicker Grid.Column="1" Grid.Row="7" Height="25" Width="300" HorizontalAlignment="Left"  BorderBrush="Green" BorderThickness="2" FontSize="13" 
                 Text="{Binding EstimatedStartDate, Mode=TwoWay, NotifyOnValidationError=true,
                   ValidatesOnExceptions=true}"/>
        <Label Grid.Column="0" Grid.Row="8" HorizontalAlignment="Right"  VerticalAlignment="Center" FontSize="15"  Content="Actual Start Date:"></Label>
        <DatePicker Grid.Column="1" Grid.Row="8" Height="25" Width="300" HorizontalAlignment="Left"  BorderBrush="Green" BorderThickness="2" FontSize="13" 
                 Text="{Binding ActualStartDate, Mode=TwoWay, NotifyOnValidationError=true,
                   ValidatesOnExceptions=true}"/>
        <Label Grid.Column="0" Grid.Row="9" HorizontalAlignment="Right"  VerticalAlignment="Center" FontSize="15"  Content="Estimated Completion Date:"></Label>
        <DatePicker Grid.Column="1" Grid.Row="9" Height="25" Width="300" HorizontalAlignment="Left"  BorderBrush="Green" BorderThickness="2" FontSize="13" 
                 Text="{Binding EstimatedCompletionDate, Mode=TwoWay, NotifyOnValidationError=true,
                   ValidatesOnExceptions=true}"/>
        <Label Grid.Column="0" Grid.Row="10" HorizontalAlignment="Right"  VerticalAlignment="Center" FontSize="15"  Content="Actual End Date:"></Label>
        <DatePicker Grid.Column="1" Grid.Row="10" Height="25" Width="300" HorizontalAlignment="Left"  BorderBrush="Green" BorderThickness="2" FontSize="13" 
                 Text="{Binding ActualEndDate, Mode=TwoWay, NotifyOnValidationError=true,
                   ValidatesOnExceptions=true}"/>
        <Label Grid.Column="0" Grid.Row="11" HorizontalAlignment="Right"  VerticalAlignment="Center" FontSize="15"  Content="Required Effort Time:"></Label>
        <TextBox Grid.Column="1" Grid.Row="11" Height="25" Width="300" HorizontalAlignment="Left" TextAlignment="Center" BorderBrush="Green" BorderThickness="2" FontSize="13"
                   Text="{Binding RequiredEffortTime, Mode=TwoWay, NotifyOnValidationError=true,
                   ValidatesOnExceptions=true}"/>
        <Label Grid.Column="0" Grid.Row="12" HorizontalAlignment="Right"  VerticalAlignment="Center" FontSize="15"  Content="Product:"></Label>
        <TextBox Grid.Column="1" Grid.Row="12" Height="25" Width="300" HorizontalAlignment="Left" TextAlignment="Center" BorderBrush="Green" BorderThickness="2" FontSize="13"
                   Text="{Binding Product, Mode=TwoWay, NotifyOnValidationError=true,
                   ValidatesOnExceptions=true}"/>
        <Label Grid.Column="0" Grid.Row="13" HorizontalAlignment="Right"  VerticalAlignment="Center" FontSize="15"  Content="Notes:"></Label>
        <TextBox Grid.Column="1" Grid.Row="13" Height="25" Width="300" HorizontalAlignment="Left" TextAlignment="Center" BorderBrush="Green" BorderThickness="2" FontSize="13"
                   Text="{Binding Notes, Mode=TwoWay, NotifyOnValidationError=true,
                   ValidatesOnExceptions=true}"/>
        <Label Grid.Column="0" Grid.Row="14" HorizontalAlignment="Right"  VerticalAlignment="Center" FontSize="15"  Content="Enginner in Task:"></Label>
        <TextBox Grid.Column="1" Grid.Row="14" Height="25" Width="300" HorizontalAlignment="Left" TextAlignment="Center" BorderBrush="Green" BorderThickness="2" FontSize="13"
                   Text="{Binding eng, Mode=TwoWay, NotifyOnValidationError=true,
                   ValidatesOnExceptions=true}"/>
        <Label Grid.Column="0" Grid.Row="15" HorizontalAlignment="Right"  VerticalAlignment="Center" FontSize="15"  Content="Difficulty Level:"></Label>
        <ComboBox Grid.Column="1" Grid.Row="15" Height="25" Width="300" HorizontalAlignment="Left"  Background="White" BorderBrush="Green" BorderThickness="2" FontSize="13" 
                  ItemsSource="{Binding Source={StaticResource ExperienceCollectionKey}}"
                  SelectedValue="{Binding DifficultyLevel, Mode=TwoWay, NotifyOnValidationError=true,
                  ValidatesOnExceptions=true}"></ComboBox>
        <Button Grid.ColumnSpan="2" Grid.Row="16" Background="Green" Foreground="White"  Height="30" Width="200" FontSize="20" 
                Content="{Binding TaskNumber, Mode=OneTime, Converter={StaticResource ConverIdToContentKey}}"
                Click="btnAddUpdate_Click" Margin="281,8,319,10"></Button>
    </Grid>
</Window>
