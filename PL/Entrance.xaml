<Window Background="AliceBlue"  x:Class="PL.Entrance"
           DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="Entrance" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2.5*"/>
            <RowDefinition Height="2.5*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>
        <Button Grid.Column="0" Grid.Row="1" Width="200" Height="100" FontSize="20" FontFamily="Candara Light"  Background="Green" Foreground="White"  BorderBrush="Black" Content="Manager View" Click="adminLogin_button"></Button>
        <Button Grid.Column="1" Grid.Row="1" Width="200" Height="100" FontSize="20" FontFamily="Candara Light"  Background="Green" Foreground="White"  BorderBrush="Black" Content="Engineer View" Click="engineerLogin_button"></Button>
        <Button Grid.ColumnSpan="3" Grid.Row="2" Width="200" Height="80" FontSize="20" FontFamily="Candara Light" Background="Green" Foreground="White"  BorderBrush="Black" Content="Initialization" Click="initalize_button"></Button>
        <Grid  Grid.ColumnSpan="3" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding CurrentTime,Mode=TwoWay}" Height="80" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="20" Grid.Column="1" Margin="0,10,0,0" />
            <Button  Width="150" Height="50" FontSize="15" FontFamily="Candara Light" Background="Green" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="Black" Content="Add Year" Click="addYear"/>
            <Button Grid.Column="1" Width="150" Height="50" FontSize="15" FontFamily="Candara Light" Background="Green" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" BorderBrush="Black" Content="Add Month" Click="addMonth"/>
            <Button Grid.Column="2"  Width="150" Height="50" FontSize="15" FontFamily="Candara Light" Background="Green" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Bottom" BorderBrush="Black" Content="Add Day" Click="addDay"/>
        </Grid>
    </Grid>
</Window>
